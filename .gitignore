*.tmp
*.temp
*.swp
*.swo
*.orig
*.rej
*~
.DS_Store
Thumbs.db

# IDE / editor settings
.vscode/
.idea/
*.iml
*.code-workspace

# OS metadata
.AppleDouble
.LSOverride
Icon?
Desktop.ini

# Package-manager caches / local state
.npm/
.pnpm-store/
.yarn/
.yarn-cache/
.yarn-integrity

# Local archives / exported builds
*.zip
*.tar
*.tar.gz
*.tgz

# Local certificates / private keys
*.pem
*.key
*.p12
*.pfx

# Optional local-only overrides
*.local
*.local.*

# Keep the project examples/templates tracked
!.env.example
!.env.*.example