!/build/
!/build/icons/
!/build/icons/icon.png
!/build/icons/icon.ico

/release/
/electron-dist/
*.AppImage
*.deb
*.dmg
*.pkg
*.exe
*.msi
*.blockmap

# Cloudflare Wrangler / local development
.wrangler/
.dev.vars
.dev.vars.*

# Environment files / local secrets
.env
.env.*
!.env.example
!.env.*.example

# Local server/runtime data
server/data.json
server/data.*.json
*.sqlite
*.sqlite3
*.db
*.db-journal

# Logs / debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Coverage / test artifacts
coverage/
.nyc_output/
.vitest/
playwright-report/
test-results/

