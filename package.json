{
  "name": "workertink",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types tests/core.test.mjs && node --experimental-strip-types tests/regression.test.mjs && node --experimental-strip-types tests/notes.test.mjs && node --experimental-strip-types tests/storage.test.mjs && node tests/smoke.test.cjs && node tests/motion.test.cjs && node tests/api-regression.test.cjs && node tests/social-regression.test.cjs",
    "api": "node server/index.mjs",
    "directory:install": "npm --prefix directory-api install",
    "directory:dev": "npm --prefix directory-api run dev",
    "directory:deploy": "npm --prefix directory-api run deploy",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:pack": "electron-builder --dir --publish never",
    "desktop:win": "electron-builder --win nsis portable --publish never",
    "desktop:mac": "electron-builder --mac dmg zip --publish never",
    "desktop:linux": "electron-builder --linux AppImage deb --publish never",
    "desktop": "electron-builder --publish never"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite-plugin-pwa": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@simplewebauthn/browser": "^14.0.0",
    "qr": "^0.7.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "description": "WorkerTink — Work OS, social network and desktop app for work schedules, teams, chats and workplace tools.",
  "author": {
    "name": "WorkerTink",
    "email": "support@workertink.app"
  }
}
