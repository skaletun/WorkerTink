{
  "name": "workertink",
  "private": true,
  "version": "7.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types tests/core.test.mjs && node --experimental-strip-types tests/regression.test.mjs && node --experimental-strip-types tests/notes.test.mjs && node --experimental-strip-types tests/storage.test.mjs && node tests/smoke.test.cjs && node tests/motion.test.cjs && node tests/api-regression.test.cjs && node tests/social-regression.test.cjs && node tests/system-integrity.test.cjs",
    "api": "npm run directory:dev",
    "directory:install": "npm --prefix directory-api install",
    "directory:dev": "npm --prefix directory-api run dev",
    "directory:deploy": "npm --prefix directory-api run deploy",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:pack": "electron-builder --dir --publish never",
    "desktop:win": "electron-builder --win nsis portable --publish never",
    "desktop:mac": "electron-builder --mac dmg zip --publish never",
    "desktop:linux": "electron-builder --linux AppImage deb --publish never",
    "desktop": "electron-builder --publish never",
    "visual:audit": "playwright test --config=playwright.config.cjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite-plugin-pwa": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@simplewebauthn/browser": "^14.0.0",
    "qr": "^0.7.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "@playwright/test": "1.63.0"
  },
  "description": "WTinker — социальная сеть для работы: люди, сообщества, общение и рабочие инструменты в одном пространстве.",
  "author": {
    "name": "WorkerTink",
    "email": "support@workertink.app"
  }
}
